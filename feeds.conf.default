src-git packages https://github.com/openwrt/packages.git
src-git luci https://github.com/openwrt/luci.git
src-git routing https://github.com/openwrt/routing.git
src-git telephony https://github.com/AgustinLorenzo/telephony.git
src-git video https://github.com/openwrt/video.git
src-git nss_packages https://github.com/AgustinLorenzo/nss-packages.git;main_nss_wifi
src-git sqm_scripts_nss_julius https://github.com/JuliusBairaktaris/sqm-scripts-nss.git
src-git qosmio https://github.com/qosmio/packages-extra.git
