#
# seed_ipq807x_1g.config — IPQ807x (1GB RAM class) shared seed
#
# Target audience: any IPQ807x / IPQ8072 / IPQ8074 board with ~1GB DRAM
# (e.g. Dynalink DL-WRX36, QNAP 301W, Xiaomi AX3600 variants with 1G, etc.)
#
# Does NOT pin a single DEVICE — keeps multi-profile selections from
# .full_config (or whatever you enable in menuconfig). Only forces the
# 1024MB memory profile + common NSS / Wi-Fi / storage knobs.
#
# Stack order:
#   cp .full_config .config
#   cat clean_seed.config >> .config         # packages (Tailscale, AdGuard, …)
#   cat seed_ipq807x_1g.config >> .config    # 1GB + NSS mem profile
#   # optional single device pin (menuconfig or DEVICE= for build script)
#   make defconfig
#

# ---------------------------------------------------------------------------
# Target family (usually already set by .full_config)
# ---------------------------------------------------------------------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y

# Keep multi-profile when present in base config (do not force single device)
# CONFIG_TARGET_MULTI_PROFILE is left as-is from .full_config

# ---------------------------------------------------------------------------
# Memory profile: 1GB DRAM class
# (overrides the 512MB multi-device compromise in .full_config)
# ---------------------------------------------------------------------------
CONFIG_IPQ_MEM_PROFILE_1024=y
# CONFIG_IPQ_MEM_PROFILE_512 is not set
# CONFIG_IPQ_MEM_PROFILE_256 is not set
CONFIG_KERNEL_IPQ_MEM_PROFILE=1024

# SKB recycler tuned for >=1GB
CONFIG_KERNEL_SKB_RECYCLER=y
CONFIG_SKB_RECYCLE_SIZE_2304=y
CONFIG_KERNEL_SKB_RECYCLE_SIZE=2304
CONFIG_KERNEL_SKB_RECYCLER_MULTI_CPU=y
# CONFIG_KERNEL_SKB_RECYCLER_PREALLOC is not set

# NSS + ath11k memory (leave room for userspace: Tailscale / AdGuard / …)
CONFIG_NSS_MEM_PROFILE_HIGH=y
CONFIG_ATH11K_MEM_PROFILE_512M=y

# ---------------------------------------------------------------------------
# Common IPQ807x offload / Wi-Fi (board packages stay per-device)
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-phy-aquantia=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y
CONFIG_ATH11K_NSS_SUPPORT=y

# NSS core + ECM (also listed in clean_seed; restate for self-contained 1G seed)
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_PACKAGE_nss-firmware-ipq807x=y
CONFIG_PACKAGE_nss-eip-firmware=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_NSS_DRV_CRYPTO_ENABLE=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_BRIDGE_ENABLE=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_PPPOE_ENABLE=y
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_kmod-qca-mcs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
# Tailscale depends on TUN
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ca-bundle=y

# ---------------------------------------------------------------------------
# Generic storage / USB helpers (eMMC, USB stick; safe on most 1G boards)
# Per-device filesystems (f2fs/ubi) remain DEVICE_PACKAGES from the target.
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb3=y
