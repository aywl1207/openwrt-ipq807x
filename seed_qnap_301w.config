#
# seed_qnap_301w.config — QNAP QHora-301W (IPQ8072) single-device seed
#
# Hardware notes:
#   - IPQ8072A, 1GB RAM, 4GB eMMC (f2fs rootfs)
#   - Dual 10GbE (10g-1=WAN, 10g-2=LAN) + 4x 1G LAN
#   - Wi-Fi 6 board data: ipq-wifi-qnap_301w
#   - eMMC sysupgrade (not NAND/UBI)
#
# Stack order:
#   cp .full_config .config
#   cat clean_seed.config >> .config      # keep ALL custom components
#   cat seed_qnap_301w.config >> .config  # pin to 301w only
#   make defconfig
#

# ---------------------------------------------------------------------------
# Single-device target (faster build, correct DEVICE_PACKAGES in rootfs)
# ---------------------------------------------------------------------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_TARGET_PER_DEVICE_ROOTFS is not set
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_qnap_301w=y

# Clear multi-profile device selections from .full_config
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_arcadyan_aw1000 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_asus_rt-ax89x is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_buffalo_wxr-5950ax12 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_dynalink_dl-wrx36 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_homewrk is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4200v1 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4200v2 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4300 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx5300 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx8500 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_netgear_rax120v2 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_netgear_sxr80 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_netgear_sxs80 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_netgear_wax218 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_qnap_301w is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_spectrum_sax1v1k is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_xiaomi_ax3600 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_xiaomi_ax9000 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_zyxel_nbg7815 is not set

# ---------------------------------------------------------------------------
# Memory profile: 301W has 1GB DRAM → 1024 (was 512 multi-device compromise)
# ---------------------------------------------------------------------------
CONFIG_IPQ_MEM_PROFILE_1024=y
# CONFIG_IPQ_MEM_PROFILE_512 is not set
# CONFIG_IPQ_MEM_PROFILE_256 is not set
CONFIG_KERNEL_IPQ_MEM_PROFILE=1024
CONFIG_KERNEL_SKB_RECYCLER=y
CONFIG_SKB_RECYCLE_SIZE_2304=y
CONFIG_KERNEL_SKB_RECYCLE_SIZE=2304
CONFIG_KERNEL_SKB_RECYCLER_MULTI_CPU=y
# CONFIG_KERNEL_SKB_RECYCLER_PREALLOC is not set
CONFIG_NSS_MEM_PROFILE_HIGH=y
CONFIG_ATH11K_MEM_PROFILE_512M=y

# ---------------------------------------------------------------------------
# Device-required packages (from Device/qnap_301w DEVICE_PACKAGES)
# Force =y so they are always in rootfs (not only as multi-profile modules)
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_ipq-wifi-qnap_301w=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_libf2fs=y

# Dual 10G (Aquantia) — DEFAULT_PACKAGES for ipq807x; restate for safety
CONFIG_PACKAGE_kmod-phy-aquantia=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y
CONFIG_ATH11K_NSS_SUPPORT=y

# ---------------------------------------------------------------------------
# NSS core (also in clean_seed; restate so single-device seed is self-consistent)
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_nss-eip-firmware=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_NSS_DRV_CRYPTO_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y

# ---------------------------------------------------------------------------
# eMMC / storage helpers useful on 301W
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb3=y
