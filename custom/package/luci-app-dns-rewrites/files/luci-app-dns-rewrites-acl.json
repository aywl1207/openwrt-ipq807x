{
	"luci-app-dns-rewrites": {
		"description": "Grant access to local DNS rewrite configuration",
		"read": {
			"uci": [ "dns_rewrite", "aykc_dns", "dhcp" ],
			"file": {
				"/etc/dnsmasq.d/10-dns-rewrites.conf": [ "read" ],
				"/etc/dnsmasq.d/10-aykc-rewrites.conf": [ "read" ],
				"/usr/sbin/dns-rewrite-apply": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "dns_rewrite", "aykc_dns", "dhcp" ],
			"file": {
				"/usr/sbin/dns-rewrite-apply": [ "exec" ]
			}
		}
	}
}
