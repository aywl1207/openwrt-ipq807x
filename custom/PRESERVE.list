# Paths restored after upstream sync (relative to repo root).
# Prefer whole trees over individual files — easier maintenance.
# Lines starting with # are ignored.

# Entire fork tree (scripts, config seeds, files overlay, docs, meta)
custom/

# Fork GitHub workflows (thin wrappers around custom/scripts)
.github/workflows/build-ipq807x.yml
.github/workflows/sync-upstream.yml

# Landing page (GitHub renders root README)
README.md
