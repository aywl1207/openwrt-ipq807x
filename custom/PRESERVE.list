# Paths restored after upstream sync (relative to repo root).
# Lines starting with # are ignored. Directories are copied recursively.

# Workflows (must survive force-push rebase)
.github/workflows/sync_fork_with_customization.yaml
.github/workflows/custom_ipq807x.yml

