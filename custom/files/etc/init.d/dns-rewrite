#!/bin/sh /etc/rc.common
# Regenerate rewrite conf early; dnsmasq loads confdir on its own start.

START=18

start() {
	[ -x /usr/sbin/dns-rewrite-apply ] || return 0
	[ -f /etc/config/dns_rewrite ] || [ -f /etc/config/aykc_dns ] || return 0
	/usr/sbin/dns-rewrite-apply --no-restart >/dev/null 2>&1 || true
}

boot() {
	start
}

stop() {
	:
}
