#!/bin/sh /etc/rc.common
# Copy ramoops/pstore crash records to /root/crashlogs (size-safe).
#
# BUG HISTORY: writing COMBINED.txt into $dest while looping `for f in $dest/*`
# and `cat $f` causes infinite self-read/write growth (fills /overlay).
# Always build summary in /tmp, never cat the output file.

START=35
STOP=90

CRASH_ROOT="${CRASH_ROOT:-/root/crashlogs}"
PSTORE_MNT="${PSTORE_MNT:-/sys/fs/pstore}"
# Per-file cap when copying from pstore / embedding in summary
MAX_FILE_BYTES="${MAX_FILE_BYTES:-65536}"
# Max summary size
MAX_SUMMARY_BYTES="${MAX_SUMMARY_BYTES:-524288}"
# Max total crashlogs tree (MB)
MAX_CRASH_MB="${MAX_CRASH_MB:-8}"

boot() {
	start
}

_prune_crashlogs() {
	local maxb used old
	maxb=$((MAX_CRASH_MB * 1024 * 1024))
	[ -d "$CRASH_ROOT" ] || return 0
	# Always drop known runaway files first
	find "$CRASH_ROOT" -type f \( -name 'COMBINED.txt' -o -name 'SUMMARY.txt' \) \
		-size +512k -delete 2>/dev/null || true
	used=$(du -sk "$CRASH_ROOT" 2>/dev/null | awk '{print $1 * 1024}')
	[ -n "$used" ] || return 0
	while [ "$used" -gt "$maxb" ] 2>/dev/null; do
		old=$(ls -1dt "$CRASH_ROOT"/pstore-* 2>/dev/null | tail -n 1)
		[ -n "$old" ] && [ -d "$old" ] || break
		rm -rf "$old"
		used=$(du -sk "$CRASH_ROOT" 2>/dev/null | awk '{print $1 * 1024}')
	done
}

start() {
	modprobe reed_solomon 2>/dev/null || true
	modprobe pstore 2>/dev/null || true
	modprobe ramoops 2>/dev/null || true

	mkdir -p "$PSTORE_MNT" 2>/dev/null || true
	if ! grep -q " $PSTORE_MNT " /proc/mounts 2>/dev/null; then
		mount -t pstore pstore "$PSTORE_MNT" 2>/dev/null || true
	fi

	# Opportunistic cleanup of old bad dumps every boot
	_prune_crashlogs

	n=$(find "$PSTORE_MNT" -type f 2>/dev/null | wc -l)
	n=$(echo "$n" | tr -d ' ')
	[ -n "$n" ] || n=0

	if [ "$n" -gt 0 ] 2>/dev/null; then
		mkdir -p "$CRASH_ROOT"
		ts=$(date +%Y%m%d-%H%M%S 2>/dev/null || echo unknown)
		dest="$CRASH_ROOT/pstore-$ts"
		mkdir -p "$dest"

		# Copy only real pstore records (never invent COMBINED here first)
		for f in "$PSTORE_MNT"/*; do
			[ -f "$f" ] || continue
			bn=$(basename "$f")
			case "$bn" in
				COMBINED.txt|SUMMARY.txt) continue ;;
			esac
			head -c "$MAX_FILE_BYTES" "$f" >"$dest/$bn" 2>/dev/null || true
		done

		# Build summary in /tmp ONLY (must not redirect into $dest during scan)
		tmp=$(mktemp /tmp/pstore-summary.XXXXXX 2>/dev/null) || tmp="/tmp/pstore-summary.$$"
		{
			echo "=== pstore dump saved $(date 2>/dev/null) ==="
			echo "=== files (capped ${MAX_FILE_BYTES}B each) ==="
			ls -la "$dest" 2>/dev/null
			echo
			for f in "$dest"/*; do
				[ -f "$f" ] || continue
				bn=$(basename "$f")
				case "$bn" in
					COMBINED.txt|SUMMARY.txt) continue ;;
				esac
				echo "======== $bn ========"
				head -c "$MAX_FILE_BYTES" "$f" 2>/dev/null
				echo
			done
		} >"$tmp" 2>/dev/null || true

		# Install capped summary (optional; primary data is the dmesg-* copies)
		if [ -s "$tmp" ]; then
			head -c "$MAX_SUMMARY_BYTES" "$tmp" >"$dest/SUMMARY.txt" 2>/dev/null || true
		fi
		rm -f "$tmp" 2>/dev/null || true

		echo "$dest" >"$CRASH_ROOT/LAST"
		logger -t pstore-save "saved $n pstore record(s) to $dest (no self-cat COMBINED)"
		rm -f "$PSTORE_MNT"/* 2>/dev/null || true
		_prune_crashlogs
	else
		logger -t pstore-save "pstore empty (no prior crash dump)"
	fi

	mkdir -p "$CRASH_ROOT"
	_prune_crashlogs
	return 0
}

stop() {
	return 0
}
