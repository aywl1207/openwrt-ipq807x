
config cloudflared 'config'
	# Keep disabled until user adds a tunnel token / cert (saves RAM).
	option enabled '0'
	list interfaces 'wan'
	option token ''
	option edge_bind_address ''
	option edge_ip_version ''
	option grace_period ''
	option protocol 'auto'
	option region ''
	option retries ''
	option tag ''
	option metrics ''
	# Less log spam on flash/tmp
	option loglevel 'warn'
	# Prefer tmpfs over flash for logs
	option logfile '/tmp/cloudflared.log'
