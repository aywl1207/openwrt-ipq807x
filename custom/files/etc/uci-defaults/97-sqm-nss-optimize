#!/bin/sh
# NSS SQM / QoS first-boot / post-upgrade setup for IPQ807x.
# - Prefer nss-zk.qos + fq_codel (hardware shaper)
# - Keep classic qos-scripts OFF (conflicts / CPU-only)
# - New queues default disabled (NSS panic-safe)
# - NEVER rewrite .enabled on existing queues (keep-settings must survive)

# Soft/hardware flow offload fights SQM + ECM — keep off (also in 99-qol_nss)
[ -n "$(uci -q get firewall.@defaults[0])" ] && {
	uci -q set firewall.@defaults[0].flow_offloading=0
	uci -q set firewall.@defaults[0].flow_offloading_hw=0
	uci -q commit firewall
}

[ -f /etc/config/sqm ] || touch /etc/config/sqm

# Only seed a template when there is no queue at all. Do not recreate
# dummy sqm.wan if the user already has wan_sqm (or any other instance).
_any_queue=0
for sid in $(uci -q show sqm | sed -n "s/^sqm\.\([^=]*\)=queue.*/\1/p"); do
	_any_queue=1
	break
done

if [ "$_any_queue" -eq 0 ]; then
	uci -q batch <<-EOF
		set sqm.wan=queue
		set sqm.wan.enabled='0'
		set sqm.wan.interface='wan'
		set sqm.wan.download='0'
		set sqm.wan.upload='0'
		set sqm.wan.qdisc='fq_codel'
		set sqm.wan.script='nss-zk.qos'
		set sqm.wan.qdisc_advanced='1'
		set sqm.wan.ingress_ecn='ECN'
		set sqm.wan.egress_ecn='NOECN'
		set sqm.wan.itarget='auto'
		set sqm.wan.etarget='auto'
		set sqm.wan.eqdisc_opts='interval 50ms'
		set sqm.wan.iqdisc_opts='interval 50ms'
		set sqm.wan.linklayer='none'
		set sqm.wan.overhead='18'
	EOF
fi

# Pin NSS script/qdisc on every queue. Do not touch .enabled.
_any_enabled=0
for sid in $(uci -q show sqm | sed -n "s/^sqm\.\([^=]*\)=queue.*/\1/p"); do
	script="$(uci -q get sqm.$sid.script)"
	qdisc="$(uci -q get sqm.$sid.qdisc)"
	case "$script" in
		piece_of_cake.qos|layer_cake.qos|simple.qos|simplest.qos|simplest_tbf.qos|"")
			uci -q set sqm.$sid.script='nss-zk.qos'
			uci -q set sqm.$sid.qdisc='fq_codel'
			;;
	esac
	case "$qdisc" in
		cake)
			uci -q set sqm.$sid.qdisc='fq_codel'
			uci -q set sqm.$sid.script='nss-zk.qos'
			;;
	esac
	en="$(uci -q get sqm.$sid.enabled)"
	[ "$en" = "1" ] && _any_enabled=1
done

uci -q commit sqm

# Classic OpenWrt qos-scripts — do not run alongside NSS SQM
if [ -x /etc/init.d/qos ]; then
	/etc/init.d/qos stop 2>/dev/null || true
	/etc/init.d/qos disable 2>/dev/null || true
fi
if [ -f /etc/config/qos ]; then
	uci -q set qos.wan.enabled='0' 2>/dev/null || true
	uci -q commit qos 2>/dev/null || true
fi

# Enable the service so LuCI / hotplug work. Do NOT start here —
# first-boot + WAN ifup racing nssmirred hangs the board.
# 99-sqm-enabled starts SQM after carrier + NSS are ready.
if [ -x /etc/init.d/sqm ]; then
	/etc/init.d/sqm enable 2>/dev/null || true
fi

exit 0
