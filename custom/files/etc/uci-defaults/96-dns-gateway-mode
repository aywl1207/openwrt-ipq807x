#!/bin/sh
# Production DNS stack (no AdGuard Home):
#   clients → dnsmasq:53 → https-dns-proxy:5053 → Cloudflare Gateway DoH
#
# Does NOT ship site-specific rewrites (address=/…/ cname=…).
# Keep those only on the live device (uci / LuCI), not in git.
# Does NOT alter per-interface DHCP options (iot/guest/etc.).
# Keep-settings: do not wipe extra dnsmasq server= lists if DoH is already set.

# --- https-dns-proxy ---------------------------------------------------------
if [ -x /etc/init.d/https-dns-proxy ]; then
	/etc/init.d/https-dns-proxy enable 2>/dev/null || true
fi

# Empty resolver_url (older overlay) leaves port 5053 dead and LAN DNS broken.
if [ -n "$(uci -q get https-dns-proxy.@https-dns-proxy[0])" ]; then
	_url="$(uci -q get https-dns-proxy.@https-dns-proxy[0].resolver_url)"
	if [ -z "$_url" ]; then
		uci -q set https-dns-proxy.@https-dns-proxy[0].resolver_url='https://cloudflare-dns.com/dns-query'
		uci -q commit https-dns-proxy
	fi
fi

# --- dnsmasq: serve DNS, forward to local DoH --------------------------------
if uci -q get dhcp.@dnsmasq[0] >/dev/null; then
	[ -z "$(uci -q get dhcp.@dnsmasq[0].port)" ] && \
		uci -q set dhcp.@dnsmasq[0].port='53'
	[ -z "$(uci -q get dhcp.@dnsmasq[0].noresolv)" ] && \
		uci -q set dhcp.@dnsmasq[0].noresolv='1'
	[ -z "$(uci -q get dhcp.@dnsmasq[0].localuse)" ] && \
		uci -q set dhcp.@dnsmasq[0].localuse='1'

	# Seed 127.0.0.1#5053 only when no DoH forwarder is listed yet.
	# Do not delete existing server= entries (keep-settings / extra stubs).
	_have_doh=0
	for _s in $(uci -q get dhcp.@dnsmasq[0].server 2>/dev/null); do
		case "$_s" in
			127.0.0.1#5053|::1#5053) _have_doh=1 ;;
		esac
	done
	if [ "$_have_doh" -eq 0 ]; then
		uci -q add_list dhcp.@dnsmasq[0].server='127.0.0.1#5053'
	fi

	uci -q commit dhcp
fi

# If an older image still has AGH, keep it off
[ -x /etc/init.d/adguardhome ] && /etc/init.d/adguardhome disable 2>/dev/null || true
[ -x /etc/init.d/adguardhome-filters ] && /etc/init.d/adguardhome-filters disable 2>/dev/null || true

exit 0
