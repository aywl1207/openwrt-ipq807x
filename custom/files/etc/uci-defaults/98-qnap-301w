#!/bin/sh
# QNAP QHora-301W first-boot tweaks (board.d already sets LAN/WAN topology).
# Keep all custom packages untouched; only apply device-local defaults.

board="$(board_name 2>/dev/null || true)"
case "$board" in
	qnap,301w) ;;
	*) exit 0 ;;
esac

# Wi-Fi regulatory (zh-TW users / clean_seed i18n)
for radio in radio0 radio1 radio2; do
	uci -q get wireless.$radio >/dev/null 2>&1 || continue
	uci -q set wireless.$radio.country='TW'
	uci -q set wireless.$radio.disabled='0'
done
uci -q commit wireless

# NSS / ECM must own offload — never enable OpenWrt SW/HW flow offloading
if uci -q get firewall.@defaults[0] >/dev/null 2>&1; then
	uci -q set firewall.@defaults[0].flow_offloading='0'
	uci -q set firewall.@defaults[0].flow_offloading_hw='0'
	uci -q commit firewall
fi

if uci -q get ecm.@general[0] >/dev/null 2>&1; then
	uci -q set ecm.@general[0].enable_bridge_filtering='0'
	uci -q commit ecm
fi

if uci -q get pbuf.opt >/dev/null 2>&1; then
	uci -q set pbuf.opt.memory_profile='auto'
	uci -q commit pbuf
fi

# Hostname
uci -q set system.@system[0].hostname='QNAP-301W'
uci -q commit system

# Enable Tailscale service if present (user still runs: tailscale up)
[ -x /etc/init.d/tailscale ] && /etc/init.d/tailscale enable

exit 0
