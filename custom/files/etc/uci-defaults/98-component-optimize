#!/bin/sh
# Per-component first-boot tuning for IPQ807x ~1GB builds.
# Safe defaults only — does not enable services that need user secrets.
# Keep-settings: only fill unset knobs (do not clobber user zram / loglevel).

# --- zram-swap ---------------------------------------------------------------
# Default formula (MemTotal_KB/2048) ≈ 512MiB zram on 1GB boards — heavy with NSS.
# Cap at 256MiB; use kernel default LZO-RLE (LZ4 backend not enabled in full_config).
if [ -n "$(uci -q get system.@system[0])" ]; then
	[ -z "$(uci -q get system.@system[0].zram_size_mb)" ] && \
		uci -q set system.@system[0].zram_size_mb='256'
	[ -z "$(uci -q get system.@system[0].zram_comp_algo)" ] && \
		uci -q set system.@system[0].zram_comp_algo='lzo-rle'
	uci -q commit system
fi

# DNS: see 96-dns-gateway-mode (https-dns-proxy + dnsmasq; no AdGuard Home)

# --- cloudflared (keep disabled; lighter logs when user enables) -------------
if [ -n "$(uci -q get cloudflared.config)" ] || [ -f /etc/config/cloudflared ]; then
	[ -z "$(uci -q get cloudflared.config.loglevel)" ] && \
		uci -q set cloudflared.config.loglevel='warn'
	[ -z "$(uci -q get cloudflared.config.logfile)" ] && \
		uci -q set cloudflared.config.logfile='/tmp/cloudflared.log'
	# do not force enabled=1
	uci -q commit cloudflared
fi

# --- SQM / QoS: handled by 97-sqm-nss-optimize (nss-zk.qos, no classic qos) ---

# --- haveged: already tiny; ensure enabled for early entropy -----------------
[ -x /etc/init.d/haveged ] && /etc/init.d/haveged enable 2>/dev/null || true

# --- zram init enable --------------------------------------------------------
[ -x /etc/init.d/zram ] && /etc/init.d/zram enable 2>/dev/null || true

# --- pstore/ramoops crash log harvest + mem-watch ----------------------------
[ -x /etc/init.d/pstore-save ] && /etc/init.d/pstore-save enable 2>/dev/null || true
mkdir -p /root/crashlogs
# 5-minute RAM pressure log (overlay); survives reboot
if [ -x /usr/sbin/mem-watch.sh ]; then
	if [ -f /etc/crontabs/root ]; then
		grep -q 'mem-watch.sh' /etc/crontabs/root 2>/dev/null || \
			echo '*/5 * * * * /usr/sbin/mem-watch.sh' >> /etc/crontabs/root
	else
		echo '*/5 * * * * /usr/sbin/mem-watch.sh' > /etc/crontabs/root
	fi
fi

exit 0
