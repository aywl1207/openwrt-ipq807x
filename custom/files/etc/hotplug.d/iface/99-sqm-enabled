#!/bin/sh
# Restart SQM when an interface used by an *enabled* queue comes up.
# Avoids rc.local sleep loops; no-op if no matching SQM instance.

[ "$ACTION" = "ifup" ] || exit 0
[ -x /etc/init.d/sqm ] || exit 0
[ -f /etc/config/sqm ] || exit 0

. /lib/functions.sh

match=0
_check_queue() {
	local en ifn
	config_get_bool en "$1" enabled 0
	[ "$en" -eq 1 ] || return 0
	config_get ifn "$1" interface
	[ -n "$ifn" ] || return 0
	# Match logical INTERFACE (e.g. wan) or kernel DEVICE (e.g. 10g-2)
	if [ "$ifn" = "$INTERFACE" ] || [ "$ifn" = "$DEVICE" ]; then
		match=1
	fi
}

config_load sqm
config_foreach _check_queue queue

[ "$match" -eq 1 ] || exit 0

logger -t sqm-hotplug "ifup $INTERFACE/$DEVICE — restarting sqm"
/etc/init.d/sqm restart
