#!/bin/sh
# Start SQM when WAN is really up. Never restart/stop (act_nssmirred panic).
# nss-zk.qos names IFB after the SQM UCI interface, which may be logical
# (wan) or physdev (10g-2). Check both. Defer until carrier + NSS exist.
[ "$ACTION" = "ifup" ] || exit 0
[ -x /etc/init.d/sqm ] || exit 0
[ -f /etc/config/sqm ] || exit 0

. /lib/functions.sh

LOCK=/var/lock/sqm-hotplug.lock
mkdir -p /var/lock
if ! mkdir "$LOCK" 2>/dev/null; then
	exit 0
fi
trap "rmdir $LOCK 2>/dev/null" EXIT

match=0
_check_queue() {
	local en ifn
	config_get_bool en "$1" enabled 0
	[ "$en" -eq 1 ] || return 0
	config_get ifn "$1" interface
	[ -n "$ifn" ] || return 0
	if [ "$ifn" = "$INTERFACE" ] || [ "$ifn" = "$DEVICE" ]; then
		match=1
	fi
}
config_load sqm
config_foreach _check_queue queue
[ "$match" -eq 1 ] || exit 0

_ifb_active() {
	local name="$1"
	[ -n "$name" ] || return 1
	[ -d "/sys/devices/virtual/net/ifb@${name}" ] || return 1
	tc qdisc show dev "ifb@${name}" 2>/dev/null | grep -q nsstbl
}

_dev_shaped() {
	local name="$1"
	[ -n "$name" ] || return 1
	[ -d "/sys/class/net/${name}" ] || return 1
	tc qdisc show dev "$name" 2>/dev/null | grep -q nsstbl
}

if _ifb_active "$INTERFACE" || _ifb_active "$DEVICE" \
	|| _dev_shaped "$INTERFACE" || _dev_shaped "$DEVICE"; then
	logger -t sqm-hotplug "ifup $INTERFACE/$DEVICE — SQM already active, skip"
	exit 0
fi

# Let NSS / ECM finish bind before attaching nssmirred.
n=0
while [ "$n" -lt 15 ]; do
	if [ -d /sys/module/qca_nss_drv ] && [ -d /proc/sys/dev/nss ]; then
		break
	fi
	sleep 1
	n=$((n + 1))
done
sleep 3

if _ifb_active "$INTERFACE" || _ifb_active "$DEVICE" \
	|| _dev_shaped "$INTERFACE" || _dev_shaped "$DEVICE"; then
	logger -t sqm-hotplug "ifup $INTERFACE/$DEVICE — became active while waiting, skip"
	exit 0
fi

logger -t sqm-hotplug "ifup $INTERFACE/$DEVICE — starting sqm (no restart)"
/etc/init.d/sqm start
