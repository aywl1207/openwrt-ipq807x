#!/bin/sh
# Apply /etc/config/dns_rewrite → /etc/dnsmasq.d/10-dns-rewrites.conf
#
# rewrite.type:
#   private — address=/domain/ip + local=/domain/  (A only)
#   public  — server=/domain/127.0.0.1#5053         (upstream / DoH)
#
# Domain forms: host.example.com | *.example.com | .example.com
# Usage: dns-rewrite-apply [--no-restart]

set -e

NO_RESTART=0
[ "${1:-}" = "--no-restart" ] && NO_RESTART=1

. /lib/functions.sh 2>/dev/null || true

OUT="${DNS_REWRITE_OUT:-/etc/dnsmasq.d/10-dns-rewrites.conf}"
DOH="${DNS_REWRITE_DOH:-127.0.0.1#5053}"
CFG="dns_rewrite"

if [ ! -f /etc/config/dns_rewrite ] && [ -f /etc/config/aykc_dns ]; then
	CFG=aykc_dns
fi

mkdir -p "$(dirname "$OUT")"
TMP="$(mktemp 2>/dev/null)" || TMP="/tmp/dns-rewrites.$$"

{
	echo "# Auto-generated by dns-rewrite-apply — do not edit"
	echo "# Source: /etc/config/${CFG}"
	echo
} >"$TMP"

if [ ! -f /etc/config/${CFG} ]; then
	mv "$TMP" "$OUT"
	echo "OK empty (no /etc/config/${CFG})"
	exit 0
fi

config_load "$CFG"

add_rewrite() {
	local section="$1"
	local enabled domain type ip host

	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get domain "$section" domain
	config_get type "$section" type private
	config_get ip "$section" ip
	[ -n "$domain" ] || return 0

	domain=$(echo "$domain" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

	case "$type" in
	public)
		host=$(echo "$domain" | sed 's|^\*\.||;s|^\.||;s|^/||;s|/$||')
		[ -n "$host" ] || return 0
		echo "server=/${host}/${DOH}"
		;;
	private|*)
		[ -n "$ip" ] || return 0
		case "$domain" in
		\*.* | .*)
			echo "address=/${domain}/${ip}"
			echo "local=/${domain}/"
			;;
		/*)
			case "$domain" in
			*/)
				echo "address=${domain}${ip}"
				echo "local=${domain}"
				;;
			*)
				echo "address=${domain}/${ip}"
				echo "local=${domain}/"
				;;
			esac
			;;
		*)
			echo "address=/${domain}/${ip}"
			echo "local=/${domain}/"
			;;
		esac
		;;
	esac
}

config_foreach add_rewrite rewrite >>"$TMP"

mv "$TMP" "$OUT"
chmod 644 "$OUT"

if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
	uci -q set dhcp.@dnsmasq[0].confdir='/etc/dnsmasq.d'
	uci -q delete dhcp.@dnsmasq[0].address 2>/dev/null || true
	uci -q delete dhcp.@dnsmasq[0].address_as_local 2>/dev/null || true
	if uci -q get dhcp.@dnsmasq[0].server >/dev/null 2>&1; then
		uci -q delete dhcp.@dnsmasq[0].server
	fi
	uci add_list dhcp.@dnsmasq[0].server="$DOH"
	while uci -q delete dhcp.@cname[0] 2>/dev/null; do :; done
	uci commit dhcp
fi

if [ "$NO_RESTART" -eq 0 ] && [ -x /etc/init.d/dnsmasq ]; then
	/etc/init.d/dnsmasq restart
fi

logger -t dns-rewrite "applied ${OUT}"
echo "OK applied ${OUT}"
