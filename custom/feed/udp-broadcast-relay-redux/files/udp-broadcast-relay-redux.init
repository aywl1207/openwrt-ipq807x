#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

PROG=/usr/sbin/udp-broadcast-relay-redux

# Resolve UCI network → L2 device. Never pass a bare UCI name like
# "lan" to --dev: the daemon ioctl()s it and exits if it is not a netdev.
collect_dev() {
	local net="$1" ifname=""

	network_get_device ifname "$net" || network_get_physdev ifname "$net" || ifname=""
	if [ -z "$ifname" ] && [ -d "/sys/class/net/$net" ]; then
		ifname="$net"
	fi
	[ -n "$ifname" ] || return 0
	[ -d "/sys/class/net/$ifname" ] || return 0
	case " $DEVS " in
	*" $ifname "*) return 0 ;;
	esac
	DEVS="${DEVS} ${ifname}"
}

start_instance() {
	local id port multicast src_override dest_override enabled

	config_get_bool enabled "$1" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get id "$1" id
	config_get port "$1" port
	config_get multicast "$1" multicast
	config_get src_override "$1" src_override
	config_get dest_override "$1" dest_override

	[ -n "$id" ] && [ -n "$port" ] || return 0

	. /lib/functions/network.sh
	network_flush_cache

	DEVS=""
	config_list_foreach "$1" network collect_dev
	set -- $DEVS
	if [ "$#" -lt 2 ]; then
		logger -t udp-broadcast-relay-redux \
			"defer id=${id} port=${port} (need 2 netdevs, have:${DEVS:- none})"
		return 0
	fi

	procd_open_instance
	procd_set_param command "$PROG" --id "$id" --port "$port"
	for ifname in $DEVS; do
		procd_append_param command --dev "$ifname"
	done
	[ -n "$multicast" ] && procd_append_param command --multicast "$multicast"
	[ -n "$src_override" ] && procd_append_param command -s "$src_override"
	[ -n "$dest_override" ] && procd_append_param command -t "$dest_override"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load udp_broadcast_relay_redux
	config_foreach start_instance udp_broadcast_relay_redux
}

service_triggers() {
	procd_add_reload_trigger udp_broadcast_relay_redux
	# Bridges (iot / lan2) may appear after START=90; reload when they do.
	procd_add_raw_trigger "interface.*" 2000 /etc/init.d/udp-broadcast-relay-redux reload
}
