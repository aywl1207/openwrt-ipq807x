#!/bin/sh
# Apply /etc/config/dns_rewrite → /etc/dnsmasq.d/10-dns-rewrites.conf
#
# rewrite.type:
#   private — address=/domain/ip + local=/domain/  (A only)
#   public  — server=/domain/<upstream>            (DoH / recursive)
#
# Domain forms: host.example.com | *.example.com | .example.com
# Usage: dns-rewrite-apply [--no-restart]
#
# Upstream order: $DNS_REWRITE_DOH → dns_rewrite.globals.upstream
#                 → https-dns-proxy listen → 127.0.0.1#5053

set -e

NO_RESTART=0
[ "${1:-}" = "--no-restart" ] && NO_RESTART=1

. /lib/functions.sh 2>/dev/null || true

# CLI overlay only (/tmp/.uci). LuCI Save lives in the rpcd session
# dir — the UI must ubus-commit dns_rewrite before calling us.
uci commit dns_rewrite >/dev/null 2>&1 || true

OUT="${DNS_REWRITE_OUT:-/etc/dnsmasq.d/10-dns-rewrites.conf}"
CFG="dns_rewrite"

# One-shot legacy migrate (site old name)
if [ ! -f /etc/config/dns_rewrite ] && [ -f /etc/config/aykc_dns ]; then
	cp -a /etc/config/aykc_dns /etc/config/dns_rewrite
	logger -t dns-rewrite "migrated /etc/config/aykc_dns → dns_rewrite"
fi

# --- helpers ---------------------------------------------------------------

normalize_domain() {
	# trim, strip trailing dots, lowercase (ASCII)
	printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\.\+$//' | tr 'A-Z' 'a-z' | tr -d '\r\n'
}

# Reject bytes that would split a dnsmasq line or inject a second directive.
# One bad UCI row must not stop dnsmasq from loading the rest of the file.
safe_token() {
	[ -n "$1" ] || return 1
	[ "${#1}" -le 253 ] || return 1
	# awk splits on newline, so a multi-line value would look clean per line.
	case "$1" in
		*[[:space:]]*) return 1 ;;
	esac
	printf '%s' "$1" | awk '
		BEGIN { ok = 1 }
		{
			if ($0 ~ /[[:space:]#\\"`\047]/) ok = 0
			if ($0 !~ /[0-9A-Za-z]/) ok = 0
		}
		END { exit ok ? 0 : 1 }
	'
}

valid_ip() {
	[ -n "$1" ] || return 1
	case "$1" in
		*[[:space:]]*) return 1 ;;
	esac
	printf '%s' "$1" | awk -F. '
		NF == 4 {
			ok = 1
			for (i = 1; i <= 4; i++) {
				if ($i !~ /^[0-9]+$/ || $i + 0 > 255) ok = 0
			}
			exit ok ? 0 : 1
		}
		{ exit 1 }
	' && return 0
	printf '%s' "$1" | awk '
		BEGIN { ok = 0 }
		{
			if ($0 ~ /^[0-9A-Fa-f:]+$/ && index($0, ":") > 0 && index($0, ":::") == 0) {
				n = split($0, p, "::")
				if (n <= 2) ok = 1
			}
		}
		END { exit ok ? 0 : 1 }
	'
}

resolve_doh() {
	if [ -n "${DNS_REWRITE_DOH:-}" ]; then
		echo "$DNS_REWRITE_DOH"
		return 0
	fi

	local u
	u=$(uci -q get dns_rewrite.globals.upstream 2>/dev/null || true)
	if [ -n "$u" ]; then
		echo "$u"
		return 0
	fi

	local addr port
	addr=$(uci -q get https-dns-proxy.@https-dns-proxy[0].listen_addr 2>/dev/null || true)
	port=$(uci -q get https-dns-proxy.@https-dns-proxy[0].listen_port 2>/dev/null || true)
	if [ -n "$port" ]; then
		echo "${addr:-127.0.0.1}#${port}"
		return 0
	fi

	echo "127.0.0.1#5053"
}

# Only set confdir when unset — never wipe address/server/cname lists.
ensure_confdir() {
	local cur
	uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1 || return 0
	cur=$(uci -q get dhcp.@dnsmasq[0].confdir 2>/dev/null || true)
	if [ -z "$cur" ]; then
		uci -q set dhcp.@dnsmasq[0].confdir='/etc/dnsmasq.d'
		mkdir -p /etc/dnsmasq.d
		uci commit dhcp
		return 1
	fi
	return 0
}

# --- build conf ------------------------------------------------------------

DOH="$(resolve_doh)"
if ! printf '%s' "$DOH" | grep -qE '^[A-Za-z0-9.:%_-]+#[0-9]{1,5}$'; then
	logger -t dns-rewrite "bad upstream '${DOH}', using 127.0.0.1#5053"
	DOH="127.0.0.1#5053"
fi
_doh_port="${DOH##*#}"
if [ "$_doh_port" -gt 65535 ] 2>/dev/null; then
	logger -t dns-rewrite "bad upstream port '${_doh_port}', using 127.0.0.1#5053"
	DOH="127.0.0.1#5053"
fi
mkdir -p "$(dirname "$OUT")"
TMP="$(mktemp 2>/dev/null)" || TMP="/tmp/dns-rewrites.$$"

{
	echo "# Auto-generated by dns-rewrite-apply — do not edit"
	echo "# Source: /etc/config/${CFG}"
	echo "# Upstream (public rules): ${DOH}"
	echo
} >"$TMP"

if [ ! -f /etc/config/${CFG} ]; then
	if [ -f "$OUT" ] && cmp -s "$TMP" "$OUT" 2>/dev/null; then
		rm -f "$TMP"
		echo "OK empty unchanged ${OUT}"
		exit 0
	fi
	mv "$TMP" "$OUT"
	chmod 644 "$OUT"
	CONFDIR_TOUCHED=0
	ensure_confdir || CONFDIR_TOUCHED=1
	if [ "$NO_RESTART" -eq 0 ] && [ -x /etc/init.d/dnsmasq ]; then
		/etc/init.d/dnsmasq restart
	fi
	logger -t dns-rewrite "applied empty ${OUT}"
	echo "OK empty ${OUT}"
	exit 0
fi

config_load "$CFG"

# Private IPv4 answers for public-looking names are dropped unless listed.
# Collect unique zones, emit rebind-domain-ok first.
_rebind_seen=" "
rebind_zone() {
	local z
	z=$(printf '%s' "$1" | sed 's/^\*\.//;s/^\.//;s|^/||;s|/$||')
	safe_token "$z" || return 0
	case "$_rebind_seen" in
	*" $z "*) return 0 ;;
	esac
	_rebind_seen="${_rebind_seen}${z} "
	echo "rebind-domain-ok=/${z}/"
}

rebind_zone_from_sec() {
	local enabled domain type
	config_get_bool enabled "$1" enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get type "$1" type private
	[ "$type" = private ] || return 0
	config_get domain "$1" domain
	[ -n "$domain" ] || return 0
	rebind_zone "$(normalize_domain "$domain")"
}

add_rewrite() {
	local section="$1"
	local enabled domain type ip comment host

	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get domain "$section" domain
	config_get type "$section" type private
	config_get ip "$section" ip
	config_get comment "$section" comment
	[ -n "$domain" ] || return 0

	domain=$(normalize_domain "$domain")
	[ -n "$domain" ] || return 0
	if ! safe_token "$domain"; then
		logger -t dns-rewrite "skip unsafe domain '${domain}'"
		return 0
	fi

	if [ -n "$comment" ]; then
		# Newlines would inject a second dnsmasq directive. Spaces stay.
		comment=$(printf '%s' "$comment" | tr -d '\r\n')
		[ -n "$comment" ] && echo "# ${comment}"
	fi

	case "$type" in
	public)
		host=$(printf '%s' "$domain" | sed 's|^\*\.||;s|^\.||;s|^/||;s|/$||')
		safe_token "$host" || return 0
		echo "server=/${host}/${DOH}"
		;;
	private|*)
		if ! valid_ip "$ip"; then
			logger -t dns-rewrite "skip ${domain}: bad address"
			return 0
		fi
		case "$domain" in
		\*.*)
			# dnsmasq zone form: leading-dot = name + subdomains
			host="${domain#*.}"
			echo "address=/.${host}/${ip}"
			echo "local=/.${host}/"
			;;
		.*)
			echo "address=/${domain}/${ip}"
			echo "local=/${domain}/"
			;;
		/*)
			case "$domain" in
			*/)
				echo "address=${domain}${ip}"
				echo "local=${domain}"
				;;
			*)
				echo "address=${domain}/${ip}"
				echo "local=${domain}/"
				;;
			esac
			;;
		*)
			echo "address=/${domain}/${ip}"
			echo "local=/${domain}/"
			;;
		esac
		;;
	esac
}

{
	config_foreach rebind_zone_from_sec rewrite
	echo
	config_foreach add_rewrite rewrite
} >>"$TMP"

CONF_CHANGED=1
if [ -f "$OUT" ] && cmp -s "$TMP" "$OUT" 2>/dev/null; then
	CONF_CHANGED=0
	rm -f "$TMP"
else
	mv "$TMP" "$OUT"
	chmod 644 "$OUT"
fi

CONFDIR_TOUCHED=0
ensure_confdir || CONFDIR_TOUCHED=1

if [ "$CONF_CHANGED" -eq 0 ] && [ "$CONFDIR_TOUCHED" -eq 0 ]; then
	logger -t dns-rewrite "unchanged ${OUT}"
	echo "OK unchanged ${OUT}"
	exit 0
fi

if [ "$NO_RESTART" -eq 0 ] && [ -x /etc/init.d/dnsmasq ]; then
	/etc/init.d/dnsmasq restart
fi

logger -t dns-rewrite "applied ${OUT} (upstream=${DOH})"
echo "OK applied ${OUT}"
