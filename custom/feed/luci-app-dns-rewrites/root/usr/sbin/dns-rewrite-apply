#!/bin/sh
# Apply /etc/config/dns_rewrite → /etc/dnsmasq.d/10-dns-rewrites.conf
#
# rewrite.type:
#   private — address=/domain/ip + local=/domain/  (A only)
#   public  — server=/domain/<upstream>            (DoH / recursive)
#
# Domain forms: host.example.com | *.example.com | .example.com
# Usage: dns-rewrite-apply [--no-restart]
#
# Upstream order: $DNS_REWRITE_DOH → dns_rewrite.globals.upstream
#                 → https-dns-proxy listen → 127.0.0.1#5053

set -e

NO_RESTART=0
[ "${1:-}" = "--no-restart" ] && NO_RESTART=1

. /lib/functions.sh 2>/dev/null || true

OUT="${DNS_REWRITE_OUT:-/etc/dnsmasq.d/10-dns-rewrites.conf}"
CFG="dns_rewrite"

# One-shot legacy migrate (site old name)
if [ ! -f /etc/config/dns_rewrite ] && [ -f /etc/config/aykc_dns ]; then
	cp -a /etc/config/aykc_dns /etc/config/dns_rewrite
	logger -t dns-rewrite "migrated /etc/config/aykc_dns → dns_rewrite"
fi

# --- helpers ---------------------------------------------------------------

normalize_domain() {
	# trim, strip trailing dots, lowercase (ASCII)
	echo "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\.\+$//' | tr 'A-Z' 'a-z'
}

resolve_doh() {
	if [ -n "${DNS_REWRITE_DOH:-}" ]; then
		echo "$DNS_REWRITE_DOH"
		return 0
	fi

	local u
	u=$(uci -q get dns_rewrite.globals.upstream 2>/dev/null || true)
	if [ -n "$u" ]; then
		echo "$u"
		return 0
	fi

	local addr port
	addr=$(uci -q get https-dns-proxy.@https-dns-proxy[0].listen_addr 2>/dev/null || true)
	port=$(uci -q get https-dns-proxy.@https-dns-proxy[0].listen_port 2>/dev/null || true)
	if [ -n "$port" ]; then
		echo "${addr:-127.0.0.1}#${port}"
		return 0
	fi

	echo "127.0.0.1#5053"
}

# Only set confdir when unset — never wipe address/server/cname lists.
ensure_confdir() {
	local cur
	uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1 || return 0
	cur=$(uci -q get dhcp.@dnsmasq[0].confdir 2>/dev/null || true)
	if [ -z "$cur" ]; then
		uci -q set dhcp.@dnsmasq[0].confdir='/etc/dnsmasq.d'
		mkdir -p /etc/dnsmasq.d
		uci commit dhcp
		return 1
	fi
	return 0
}

# --- build conf ------------------------------------------------------------

DOH="$(resolve_doh)"
mkdir -p "$(dirname "$OUT")"
TMP="$(mktemp 2>/dev/null)" || TMP="/tmp/dns-rewrites.$$"

{
	echo "# Auto-generated by dns-rewrite-apply — do not edit"
	echo "# Source: /etc/config/${CFG}"
	echo "# Upstream (public rules): ${DOH}"
	echo
} >"$TMP"

if [ ! -f /etc/config/${CFG} ]; then
	if [ -f "$OUT" ] && cmp -s "$TMP" "$OUT" 2>/dev/null; then
		rm -f "$TMP"
		echo "OK empty unchanged ${OUT}"
		exit 0
	fi
	mv "$TMP" "$OUT"
	chmod 644 "$OUT"
	CONFDIR_TOUCHED=0
	ensure_confdir || CONFDIR_TOUCHED=1
	if [ "$NO_RESTART" -eq 0 ] && [ -x /etc/init.d/dnsmasq ]; then
		/etc/init.d/dnsmasq restart
	fi
	logger -t dns-rewrite "applied empty ${OUT}"
	echo "OK empty ${OUT}"
	exit 0
fi

config_load "$CFG"

add_rewrite() {
	local section="$1"
	local enabled domain type ip comment host

	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get domain "$section" domain
	config_get type "$section" type private
	config_get ip "$section" ip
	config_get comment "$section" comment
	[ -n "$domain" ] || return 0

	domain=$(normalize_domain "$domain")
	[ -n "$domain" ] || return 0

	[ -n "$comment" ] && echo "# ${comment}"

	case "$type" in
	public)
		host=$(echo "$domain" | sed 's|^\*\.||;s|^\.||;s|^/||;s|/$||')
		[ -n "$host" ] || return 0
		echo "server=/${host}/${DOH}"
		;;
	private|*)
		[ -n "$ip" ] || return 0
		case "$domain" in
		\*.* | .*)
			echo "address=/${domain}/${ip}"
			echo "local=/${domain}/"
			;;
		/*)
			case "$domain" in
			*/)
				echo "address=${domain}${ip}"
				echo "local=${domain}"
				;;
			*)
				echo "address=${domain}/${ip}"
				echo "local=${domain}/"
				;;
			esac
			;;
		*)
			echo "address=/${domain}/${ip}"
			echo "local=/${domain}/"
			;;
		esac
		;;
	esac
}

config_foreach add_rewrite rewrite >>"$TMP"

CONF_CHANGED=1
if [ -f "$OUT" ] && cmp -s "$TMP" "$OUT" 2>/dev/null; then
	CONF_CHANGED=0
	rm -f "$TMP"
else
	mv "$TMP" "$OUT"
	chmod 644 "$OUT"
fi

CONFDIR_TOUCHED=0
ensure_confdir || CONFDIR_TOUCHED=1

if [ "$CONF_CHANGED" -eq 0 ] && [ "$CONFDIR_TOUCHED" -eq 0 ]; then
	logger -t dns-rewrite "unchanged ${OUT}"
	echo "OK unchanged ${OUT}"
	exit 0
fi

if [ "$NO_RESTART" -eq 0 ] && [ -x /etc/init.d/dnsmasq ]; then
	/etc/init.d/dnsmasq restart
fi

logger -t dns-rewrite "applied ${OUT} (upstream=${DOH})"
echo "OK applied ${OUT}"
