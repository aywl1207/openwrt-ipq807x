#!/bin/sh
# First-boot / package install: ensure UCI skeleton, confdir, legacy migrate.

. /lib/functions.sh

# Legacy site name → standard config (once)
if [ ! -f /etc/config/dns_rewrite ] && [ -f /etc/config/aykc_dns ]; then
	cp -a /etc/config/aykc_dns /etc/config/dns_rewrite
fi

[ -f /etc/config/dns_rewrite ] || {
	touch /etc/config/dns_rewrite
	uci -q set dns_rewrite.globals=dns_rewrite
	uci -q set dns_rewrite.globals.description='Local DNS rewrite list'
	uci -q commit dns_rewrite
}

# Soft confdir only when unset (do not touch server/address/cname)
if [ -n "$(uci -q get dhcp.@dnsmasq[0])" ]; then
	cur="$(uci -q get dhcp.@dnsmasq[0].confdir 2>/dev/null || true)"
	if [ -z "$cur" ]; then
		uci -q set dhcp.@dnsmasq[0].confdir='/etc/dnsmasq.d'
		mkdir -p /etc/dnsmasq.d
		uci -q commit dhcp
	fi
fi

[ -x /etc/init.d/dns-rewrite ] && /etc/init.d/dns-rewrite enable 2>/dev/null || true

# Only if the image still ships ucitrack (older LuCI). SNAPSHOT uses
# procd config.change from init.d/dns-rewrite instead.
if [ -f /etc/config/ucitrack ] && ! uci -q show ucitrack | grep -q "dns_rewrite"; then
	uci -q add ucitrack dns_rewrite
	uci -q set ucitrack.@dns_rewrite[-1].init='dns-rewrite'
	uci -q commit ucitrack
fi

# Generate conf once if apply is available (no dnsmasq restart here; boot order handles it)
[ -x /usr/sbin/dns-rewrite-apply ] && /usr/sbin/dns-rewrite-apply --no-restart >/dev/null 2>&1 || true

exit 0
