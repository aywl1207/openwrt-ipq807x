#!/bin/sh /etc/rc.common
# Generate /etc/dnsmasq.d/10-dns-rewrites.conf from UCI.
# Boot: write conf only (dnsmasq starts later). Reload: apply may restart dnsmasq.

START=18
USE_PROCD=1

start_service() {
	[ -x /usr/sbin/dns-rewrite-apply ] || return 0
	[ -f /etc/config/dns_rewrite ] || return 0
	/usr/sbin/dns-rewrite-apply --no-restart >/dev/null 2>&1 || true
}

reload_service() {
	[ -x /usr/sbin/dns-rewrite-apply ] || return 0
	/usr/sbin/dns-rewrite-apply >/dev/null 2>&1 || true
}

service_triggers() {
	procd_add_reload_trigger dns_rewrite
}
