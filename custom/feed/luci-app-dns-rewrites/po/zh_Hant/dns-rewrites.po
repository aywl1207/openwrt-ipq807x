msgid "DNS Custom Rewrites"
msgstr "DNS 自訂改寫"

msgid "DNS Rewrites"
msgstr "DNS 自訂改寫"

msgid "Override DNS names on this router (dnsmasq)."
msgstr "在本機 dnsmasq 覆寫 DNS 名稱。"

msgid "<strong>Private IP</strong>: always return a fixed IPv4 (LAN / NAS). Local only — no public AAAA."
msgstr "<strong>私人 IP</strong>：固定回傳 IPv4（區網／NAS）。只在本機解析，不含公網 AAAA。"

msgid "<strong>Public</strong>: look up via upstream DNS (default local DoH 127.0.0.1#5053). Use when a private wildcard would wrongly catch the name."
msgstr "<strong>公開</strong>：走上游 DNS（預設本機 DoH 127.0.0.1#5053）。避免被私人萬用字元誤攔時使用。"

msgid "Name formats:"
msgstr "名稱格式："

msgid "one host"
msgstr "單一主機"

msgid "all subdomains (not the apex name)"
msgstr "所有子網域（不含頂層名稱）"

msgid "whole domain tree"
msgstr "整個網域樹"

msgid "More specific rules win over wildcards."
msgstr "較具體的規則優先於萬用字元。"

msgid "Save &amp; Apply updates the config. dnsmasq restarts only if the file changed (Wi-Fi is not touched)."
msgstr "「儲存並套用」寫入設定；檔案有變更才重啟 dnsmasq（不影響 Wi-Fi）。"

msgid "Settings"
msgstr "設定"

msgid "Public upstream"
msgstr "公開規則上游"

msgid "Optional. Empty = https-dns-proxy port, else 127.0.0.1#5053. Format host#port."
msgstr "選填。留空則用 https-dns-proxy 埠，否則 127.0.0.1#5053。格式：主機#埠。"

msgid "Invalid format (example: 127.0.0.1#5053)"
msgstr "格式錯誤（例：127.0.0.1#5053）"

msgid "Description"
msgstr "說明"

msgid "Rules"
msgstr "規則"

msgid "Enabled"
msgstr "啟用"

msgid "Domain"
msgstr "網域"

msgid "Domain is required"
msgstr "請填寫網域"

msgid "Invalid domain (use host.example.com, *.example.com, or .example.com)"
msgstr "網域無效（例：host.example.com、*.example.com、.example.com）"

msgid "Type"
msgstr "類型"

msgid "Private IP"
msgstr "私人 IP"

msgid "Public"
msgstr "公開"

msgid "IPv4"
msgstr "IPv4"

msgid "IPv4 is required for Private IP"
msgstr "私人 IP 須填寫 IPv4"

msgid "Note"
msgstr "備註"

msgid "optional"
msgstr "選填"

msgid "Generated config"
msgstr "產生的設定"

msgid "Preview of %s"
msgstr "預覽：%s"

msgid "(not generated yet — use Save & Apply)"
msgstr "（尚未產生 — 請按「儲存並套用」）"

msgid "Applied; dnsmasq restarted if needed."
msgstr "已套用；必要時已重啟 dnsmasq。"

msgid "No change; dnsmasq not restarted."
msgstr "無變更；未重啟 dnsmasq。"

msgid "Error: %s"
msgstr "錯誤：%s"

msgid "Grant access to local DNS rewrite configuration"
msgstr "允許存取本機 DNS 改寫"
