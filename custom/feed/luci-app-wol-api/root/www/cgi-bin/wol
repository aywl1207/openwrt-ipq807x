#!/bin/sh
# Wake-on-LAN API for Home Assistant
# GET /cgi-bin/wol?target=NAME&token=TOKEN
# GET /cgi-bin/wol?action=list&token=TOKEN
#
# Auth (any one works with OpenWrt uhttpd):
#   ?token=TOKEN
#   Authorization: Bearer TOKEN   ← use this for HA rest_command headers
#   Authorization: TOKEN
#
# X-WOL-Token / other custom headers: NOT passed by uhttpd CGI → always fail.

export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
EWAKE="/usr/bin/etherwake"
[ -x "$EWAKE" ] || EWAKE="/usr/bin/ether-wake"

json_out() {
	_code="$1"
	_body="$2"
	printf "Status: %s\r\n" "$_code"
	printf "Content-Type: application/json\r\n"
	printf "Cache-Control: no-store\r\n"
	printf "\r\n"
	printf "%s\n" "$_body"
}

json_esc() {
	printf '%s' "$1" | sed 's/\\/\\\\/g;s/"/\\"/g' | tr -d '\r\n'
}

valid_name() {
	echo "$1" | grep -qE '^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$'
}

valid_mac() {
	echo "$1" | grep -qiE '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'
}

# etherwake -i must be a real netdev; never pass raw query/UCI through the shell.
valid_iface() {
	case "$1" in
	""|*[^A-Za-z0-9_.:-]*) return 1 ;;
	esac
	[ -d "/sys/class/net/$1" ]
}

qs="${QUERY_STRING:-}"
get_qs() {
	echo "$qs" | tr '&' '\n' | sed -n "s/^${1}=//p" | head -n1
}

# Conservative %HH decode. Skip the loop when the value is already literal.
urldecode() {
	local s="$1" out="" hex
	case "$s" in
	*%*|*"+"*) ;;
	*) printf '%s' "$s"; return 0 ;;
	esac
	s=$(printf '%s' "$s" | sed 's/+/ /g')
	while [ -n "$s" ]; do
		case "$s" in
		%??*)
			hex=$(printf '%s' "$s" | cut -c2-3)
			case "$hex" in
			[0-9A-Fa-f][0-9A-Fa-f])
				out="${out}$(printf "\\x${hex}")"
				s=$(printf '%s' "$s" | cut -c4-)
				;;
			*)
				out="${out}%"
				s=$(printf '%s' "$s" | cut -c2-)
				;;
			esac
			;;
		*)
			out="${out}$(printf '%s' "$s" | cut -c1)"
			s=$(printf '%s' "$s" | cut -c2-)
			;;
		esac
	done
	printf '%s' "$out"
}

tok_cfg=$(uci -q get wol_api.globals.token)
enabled=$(uci -q get wol_api.globals.enabled)
if [ "$enabled" = "0" ]; then
	json_out "503 Service Unavailable" '{"ok":false,"error":"disabled"}'
	exit 0
fi
if [ -z "$tok_cfg" ]; then
	json_out "500 Internal Server Error" '{"ok":false,"error":"no token configured"}'
	exit 0
fi

tok_q=$(get_qs token)

# Authorization (uhttpd exports HTTP_AUTHORIZATION; custom X-* headers are dropped)
tok_a=""
auth="${HTTP_AUTHORIZATION:-}"
if [ -n "$auth" ]; then
	auth=$(echo "$auth" | tr -d "\r")
	auth=$(echo "$auth" | sed "s/^ *//;s/ *$//")
	first=$(echo "$auth" | cut -d" " -f1 | tr "A-Z" "a-z")
	rest=$(echo "$auth" | cut -d" " -f2-)
	if [ "$first" = "bearer" ] || [ "$first" = "token" ]; then
		tok_a="$rest"
	else
		tok_a="$auth"
	fi
	tok_a=$(echo "$tok_a" | sed "s/^ *//;s/ *$//")
fi

if [ -n "$tok_q" ]; then
	tok="$tok_q"
elif [ -n "$tok_a" ]; then
	tok="$tok_a"
else
	tok=""
fi

if [ "$tok" != "$tok_cfg" ]; then
	logger -t wol-api "auth fail from ${REMOTE_ADDR:-?} (use ?token= or Authorization Bearer; X-WOL-Token unsupported by uhttpd)"
	json_out "401 Unauthorized" '{"ok":false,"error":"unauthorized","hint":"use ?token= or Authorization: Bearer TOKEN (X-WOL-Token is not supported by uhttpd)"}'
	exit 0
fi

action=$(get_qs action)
[ -z "$action" ] && action="wake"
target=$(get_qs target)
target=$(urldecode "$target")
mac_q=$(get_qs mac)
mac_q=$(echo "$mac_q" | tr 'a-f' 'A-F')

if [ "$action" = "list" ]; then
	body='{"ok":true,"targets":['
	first=1
	i=0
	while uci -q get wol_api.@target[$i] >/dev/null 2>&1; do
		en=$(uci -q get wol_api.@target[$i].enabled)
		if [ "$en" != "0" ]; then
			n=$(uci -q get wol_api.@target[$i].name)
			m=$(uci -q get wol_api.@target[$i].mac)
			ifc=$(uci -q get wol_api.@target[$i].interface)
			[ "$first" = 1 ] || body="${body},"
			first=0
			body="${body}{\"name\":\"$(json_esc "$n")\",\"mac\":\"$(json_esc "$m")\",\"interface\":\"$(json_esc "$ifc")\"}"
		fi
		i=$((i + 1))
	done
	body="${body}]}"
	json_out "200 OK" "$body"
	exit 0
fi

mac=""
ifc="br-lan"
bcast="1"
name=""

if [ -n "$target" ]; then
	if ! valid_name "$target"; then
		json_out "400 Bad Request" '{"ok":false,"error":"bad target"}'
		exit 0
	fi
	i=0
	found=0
	tl=$(echo "$target" | tr 'A-Z' 'a-z')
	while uci -q get wol_api.@target[$i] >/dev/null 2>&1; do
		n=$(uci -q get wol_api.@target[$i].name)
		nl=$(echo "$n" | tr 'A-Z' 'a-z')
		if [ "$nl" = "$tl" ]; then
			en=$(uci -q get wol_api.@target[$i].enabled)
			if [ "$en" = "0" ]; then
				json_out "403 Forbidden" '{"ok":false,"error":"target disabled"}'
				exit 0
			fi
			mac=$(uci -q get wol_api.@target[$i].mac)
			ifc=$(uci -q get wol_api.@target[$i].interface)
			[ -z "$ifc" ] && ifc="br-lan"
			bcast=$(uci -q get wol_api.@target[$i].broadcast)
			[ -z "$bcast" ] && bcast="1"
			name="$n"
			found=1
			break
		fi
		i=$((i + 1))
	done
	if [ "$found" != 1 ]; then
		json_out "404 Not Found" "{\"ok\":false,\"error\":\"unknown target\",\"target\":\"$(json_esc "$target")\"}"
		exit 0
	fi
elif [ -n "$mac_q" ]; then
	allow=$(uci -q get wol_api.globals.allow_mac)
	if [ "$allow" != "1" ]; then
		json_out "403 Forbidden" '{"ok":false,"error":"raw mac not allowed"}'
		exit 0
	fi
	mac="$mac_q"
	ifc=$(get_qs interface)
	ifc=$(urldecode "$ifc")
	[ -z "$ifc" ] && ifc="br-lan"
	name="$mac"
else
	json_out "400 Bad Request" '{"ok":false,"error":"need target=NAME or action=list"}'
	exit 0
fi

if ! valid_mac "$mac"; then
	json_out "400 Bad Request" "{\"ok\":false,\"error\":\"bad mac\",\"mac\":\"$(json_esc "$mac")\"}"
	exit 0
fi

if ! valid_iface "$ifc"; then
	json_out "400 Bad Request" "{\"ok\":false,\"error\":\"bad interface\",\"interface\":\"$(json_esc "$ifc")\"}"
	exit 0
fi

if [ ! -x "$EWAKE" ]; then
	json_out "500 Internal Server Error" '{"ok":false,"error":"etherwake missing"}'
	exit 0
fi

set -- -i "$ifc"
[ "$bcast" = "1" ] && set -- "$@" -b
out=$("$EWAKE" "$@" "$mac" 2>&1)
rc=$?
if [ "$rc" -eq 0 ]; then
	logger -t wol-api "wake ok name=$name mac=$mac if=$ifc from=${REMOTE_ADDR:-?}"
	json_out "200 OK" "{\"ok\":true,\"woke\":\"$(json_esc "$name")\",\"mac\":\"$(json_esc "$mac")\",\"interface\":\"$(json_esc "$ifc")\",\"broadcast\":${bcast}}"
else
	out_e=$(echo "$out" | tr '\n' ' ' | tr -d '\r' | sed "s/\"/'/g")
	logger -t wol-api "wake fail name=$name mac=$mac rc=$rc out=$out_e"
	json_out "500 Internal Server Error" "{\"ok\":false,\"error\":\"etherwake failed\",\"detail\":\"$(json_esc "$out_e")\"}"
fi
exit 0
