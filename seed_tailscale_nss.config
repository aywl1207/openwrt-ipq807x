#
# seed_tailscale_nss.config
# IPQ807x + NSS hardware offload + Tailscale (size/RAM-conscious) seed fragment
#
# Usage (matches this repo CI workflow):
#   cp -f .full_config .config
#   cat clean_seed.config >> .config
#   cat seed_tailscale_nss.config >> .config   # optional if clean_seed already merged
#   make defconfig
#
# Or standalone overlay onto any base .config:
#   cat seed_tailscale_nss.config >> .config && make defconfig
#

# ---------------------------------------------------------------------------
# Target (usually already set by .full_config; kept for standalone seeds)
# ---------------------------------------------------------------------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y

# ---------------------------------------------------------------------------
# Tailscale VPN (userspace WireGuard-compatible mesh)
# Depends: kmod-tun, ca-bundle, golang host toolchain at build time
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_kmod-tun=y
# Optional LuCI app if present in feeds (ignore if symbol missing after defconfig)
# CONFIG_PACKAGE_luci-app-tailscale is not set

# ---------------------------------------------------------------------------
# NSS core drivers & connection manager (hardware acceleration)
# DEFAULT_PACKAGES on ipq807x already pull drv+ecm; restate for clarity.
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_nss-eip-firmware=y

# NSS firmware channel (this tree prefers 12.5 in clean_seed)
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# CONFIG_NSS_FIRMWARE_VERSION_11_4 is not set

# Crypto offload feature flag inside nss-drv
CONFIG_NSS_DRV_CRYPTO_ENABLE=y

# ---------------------------------------------------------------------------
# Essential NSS client modules for home-router offload paths
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y

# Wi-Fi offload path (ath11k + NSS)
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y
CONFIG_ATH11K_NSS_SUPPORT=y

# Common L2/L3 deps used by ECM / PPPoE / bonding
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-nft-compat=y

# ---------------------------------------------------------------------------
# SQM on NSS (optional QoS; present in clean_seed)
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_luci-app-sqm=y

# ---------------------------------------------------------------------------
# Memory helpers for 512MB–1GB class routers when Tailscale is enabled
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_PACKAGE_kmod-crypto-acompress=y

# ---------------------------------------------------------------------------
# NSS runtime knobs (must NOT enable Linux SW flow offload; NSS/ECM owns it)
# Applied at first boot via files/etc/uci-defaults — see CI custom_ipq807x.yml
#   pbuf.opt.memory_profile=auto
#   firewall.defaults.flow_offloading=0
#   firewall.defaults.flow_offloading_hw=0
#   ecm.general.enable_bridge_filtering=0
# ---------------------------------------------------------------------------
